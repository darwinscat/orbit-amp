diff --git a/modules/juce_core/misc/juce_RuntimePermissions.cpp b/modules/juce_core/misc/juce_RuntimePermissions.cpp
index 1fb7cff..d6241e8 100644
--- a/modules/juce_core/misc/juce_RuntimePermissions.cpp
+++ b/modules/juce_core/misc/juce_RuntimePermissions.cpp
@@ -32,10 +32,54 @@
   ==============================================================================
 */
 
+#if JUCE_MAC
+ #import <AVFoundation/AVFoundation.h>
+#endif
+
 namespace juce
 {
 
-#if ! JUCE_ANDROID  // We currently don't request runtime permissions on any other platform
+#if JUCE_MAC  // The microphone: macOS asks the player once, and an input opened before the answer waits for it.
+
+static AVAuthorizationStatus microphoneStatus()
+{
+    return [AVCaptureDevice authorizationStatusForMediaType: AVMediaTypeAudio];
+}
+
+bool RuntimePermissions::isRequired (PermissionID permission)
+{
+    return permission == recordAudio;
+}
+
+bool RuntimePermissions::isGranted (PermissionID permission)
+{
+    return permission != recordAudio || microphoneStatus() == AVAuthorizationStatusAuthorized;
+}
+
+void RuntimePermissions::request (PermissionID permission, Callback callback)
+{
+    if (permission != recordAudio)
+    {
+        callback (true);
+        return;
+    }
+
+    const auto status = microphoneStatus();
+
+    if (status != AVAuthorizationStatusNotDetermined)   // answered before: macOS will not ask again
+    {
+        callback (status == AVAuthorizationStatusAuthorized);
+        return;
+    }
+
+    [AVCaptureDevice requestAccessForMediaType: AVMediaTypeAudio
+                             completionHandler: ^(BOOL granted)
+                             {
+                                 dispatch_async (dispatch_get_main_queue(), ^{ callback (granted == YES); });
+                             }];
+}
+
+#elif ! JUCE_ANDROID  // We currently don't request runtime permissions on any other platform
                     // than Android, so this file contains a dummy implementation for those.
                     // This may change in the future.
 
