diff --git a/modules/juce_audio_plugin_client/juce_PluginList.h b/modules/juce_audio_plugin_client/juce_PluginList.h
new file mode 100644
index 0000000..1537a69
--- /dev/null
+++ b/modules/juce_audio_plugin_client/juce_PluginList.h
@@ -0,0 +1,74 @@
+/*
+  ==============================================================================
+
+   A PLUG-IN BINARY THAT HOLDS SEVERAL PLUG-INS. Not part of JUCE: added by a
+   patch the building project applies (darwinscat/orbit-amp,
+   cmake/patches), and read only where JUCE_PLUGIN_LIST_HEADER is defined.
+
+  ==============================================================================
+*/
+
+#pragma once
+
+#include <cstdint>
+
+namespace juce
+{
+
+class AudioProcessor;
+
+/** One plug-in of the several that one binary holds.
+
+    A binary normally holds one plug-in, and every format wrapper takes its name, its code and its
+    categories from the JucePlugin_ macros of the target that built it. A target that defines
+    JUCE_PLUGIN_LIST_HEADER — the name of a header on its include path — holds every plug-in that
+    header lists instead, and the wrappers register each of them with the identity it would have as
+    a binary of its own: its VST3 component and controller class ids are made from
+    JucePlugin_ManufacturerCode and its code exactly as a single build makes them, and its CLAP id
+    is its own. A session saved with the plug-in built alone opens it from the list unchanged.
+
+    The header the macro names includes this one and defines the list, in the order hosts show it:
+
+        inline constexpr const char* clapFeatures[] { "audio-effect", nullptr };
+
+        inline constexpr juce::PluginListEntry jucePluginList[]
+        {
+            { "Gain", "Gain", "com.example.gain", "Fx", clapFeatures },
+            { "Tilt", "Tilt", "com.example.tilt", "Fx|EQ", clapFeatures },
+        };
+
+    and the binary defines createPluginFilter (const juce::PluginListEntry&), below, instead of
+    createPluginFilter().
+
+    What the entries share is the binary's: the manufacturer and its code, the version, the
+    website, and every trait a wrapper reads once for the whole binary — synth or effect, MIDI in
+    and out, the preferred channel configurations, the VST3 class flags.
+
+    This header is plain data and includes nothing of JUCE: the VST3 manifest helper compiles the
+    list to write moduleinfo.json, and that tool is built without JUCE's modules.
+*/
+struct PluginListEntry
+{
+    const char* name;                 // what hosts show: the VST3 class name, the CLAP name
+    const char* code;                 // exactly four characters, as PLUGIN_CODE
+    const char* clapId;               // as CLAP_ID
+    const char* vst3Categories;       // '|'-joined, as VST3_CATEGORIES makes JucePlugin_Vst3Category
+    const char* const* clapFeatures;  // nullptr-terminated, as CLAP_FEATURES
+};
+
+/** An entry's four characters as the integer PLUGIN_CODE makes of them (JucePlugin_PluginCode). */
+constexpr uint32_t pluginListCode (const char* code) noexcept
+{
+    return ((uint32_t) (unsigned char) code[0] << 24)
+         | ((uint32_t) (unsigned char) code[1] << 16)
+         | ((uint32_t) (unsigned char) code[2] << 8)
+         |  (uint32_t) (unsigned char) code[3];
+}
+
+} // namespace juce
+
+/** What a binary with a plug-in list defines instead of createPluginFilter(): a new processor for
+    one instance of the entry the host asked for. Every wrapper passes the entry it is making, so a
+    processor learns which plug-in it is from its argument and never from anything global.
+*/
+juce::AudioProcessor* createPluginFilter (const juce::PluginListEntry&);
